# 复制为 .env.local（勿提交密钥）
# 参照《Coze项目代码结构规范_多租户》：DATABASE_URL 由环境注入，禁止硬编码

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
AUTH_SECRET=请替换为足够长的随机字符串

# 扣子对象存储（平台自动注入，代码通过 coze-coding-dev-sdk / S3Storage 读取）
# 鉴权为 workload identity（x-storage-token），无需自行配置 access_key / secret_key
# 有 COZE_PROJECT_ENV 时附件必须上传到对象存储，失败会直接报错（不回退本地盘）
# COZE_BUCKET_ENDPOINT_URL=
# COZE_BUCKET_NAME=
# COZE_PROJECT_ENV=DEV
